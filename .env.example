# =============================================================================
# ProjectX Platform - Environment Configuration Template (.env.example)
# Copy this file to .env or .env.local and populate with your environment values.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & SERVER ENVIRONMENT
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development # Options: development | staging | production | test
LOG_LEVEL=info # Options: debug | info | warn | error

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Local SQLite for Development:
# DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL for Staging / Production:
DATABASE_URL="postgresql://projectx_user:your_secure_db_password@localhost:5432/projectx_prod?schema=public&sslmode=prefer"

# -----------------------------------------------------------------------------
# 3. JWT & SESSION SECURITY
# -----------------------------------------------------------------------------
# Generate high-entropy 256-bit keys for production (e.g., `openssl rand -base64 48`)
JWT_SECRET="replace_with_a_long_random_jwt_access_secret_key"
JWT_REFRESH_SECRET="replace_with_a_long_random_jwt_refresh_secret_key"
JWT_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# 4. CORS & NETWORK ACCESS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins or wildcards for staging/dev
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://app.projectx.edu"
FRONTEND_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# 5. AI SERVICE & CREDENTIALS
# -----------------------------------------------------------------------------
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_API_KEY="your_optional_internal_ai_gateway_key"
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# -----------------------------------------------------------------------------
# 6. EMAIL & SMTP NOTIFICATION SERVICE
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey"
SMTP_PASS="your_sendgrid_or_ses_smtp_password"
EMAIL_FROM="ProjectX Platform <no-reply@projectx.edu>"

# -----------------------------------------------------------------------------
# 7. GITHUB INTEGRATION CREDENTIALS (OPTIONAL EVIDENCE SYNC)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
GITHUB_TOKEN="your_optional_github_personal_access_token_for_higher_rate_limits"

# -----------------------------------------------------------------------------
# 8. STORAGE DRIVER & CLOUD BUCKET
# -----------------------------------------------------------------------------
STORAGE_DRIVER="local" # Options: local | s3
STORAGE_UPLOAD_DIR="uploads"
# S3 Configuration (Required if STORAGE_DRIVER=s3):
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="projectx-uploads-production"

# -----------------------------------------------------------------------------
# 9. SUPPORT & INSTITUTIONAL SAFETY CONTACTS
# -----------------------------------------------------------------------------
SUPPORT_EMAIL="support@projectx.edu"
SUPPORT_PHONE="+1 (800) 555-0199"

# -----------------------------------------------------------------------------
# 10. ERROR TRACKING & TELEMETRY
# -----------------------------------------------------------------------------
SENTRY_DSN="" # Sentry DSN for error monitoring hooks (e.g. https://xyz@sentry.io/123)
