{
  "name": "projectx",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Cross-College Student Project Team Formation Platform",
  "workspaces": [
    "packages/*",
    "apps/backend",
    "apps/web"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev:backend": "npm --prefix apps/backend run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:desktop": "electron .",
    "dev:ai": "cd apps/ai-service && uvicorn app.main:app --reload --port 8000",
    "build:packages": "npm --prefix packages/common run build && npm --prefix packages/db run build",
    "build:backend": "npm --prefix apps/backend run build",
    "build:web": "npm --prefix apps/web run build",
    "build:desktop": "npm run build:web && electron-builder",
    "build:all": "npm run build:packages && npm run build:backend && npm run build:web",
    "db:generate": "npm --prefix packages/db run generate",
    "db:push": "npm --prefix packages/db run db:push",
    "db:migrate": "npm --prefix packages/db run migrate:deploy",
    "db:migrate:dev": "npm --prefix packages/db run migrate:dev",
    "db:seed": "npm --prefix packages/db run seed",
    "db:studio": "npm --prefix packages/db run db:studio",
    "test:backend": "npm --prefix apps/backend run test",
    "test:ai": "cd apps/ai-service && pytest",
    "test": "npm run test:backend"
  },
  "keywords": [
    "team-formation",
    "cross-college",
    "ai",
    "student-projects",
    "collaboration"
  ],
  "author": "ProjectX Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.2.0"
  },
  "build": {
    "appId": "edu.projectx.desktop",
    "productName": "ProjectX",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "apps/web/dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
