PORT=4000
NODE_ENV=staging
LOG_LEVEL=info

DATABASE_URL="postgresql://projectx_staging:staging_secret_db_pass@staging-db.projectx.internal:5432/projectx_staging?schema=public&sslmode=prefer"

JWT_SECRET="staging_jwt_access_secret_projectx_staging_cluster_2026"
JWT_REFRESH_SECRET="staging_jwt_refresh_secret_projectx_staging_cluster_2026"
JWT_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="https://staging.projectx.edu,https://staging-admin.projectx.edu"
ALLOWED_ORIGINS="https://staging.projectx.edu,https://staging-admin.projectx.edu"
FRONTEND_URL="https://staging.projectx.edu"

AI_SERVICE_URL="http://staging-ai-service:8000"
