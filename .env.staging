SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey"
SMTP_PASS="SG.staging_mock_key"
EMAIL_FROM="ProjectX Staging <staging-notifications@projectx.edu>"

GITHUB_CLIENT_ID=""
